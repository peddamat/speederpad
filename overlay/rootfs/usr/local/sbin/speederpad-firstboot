#!/bin/bash
# One-time setup on the first boot after flashing:
#  * grow the root filesystem to fill the eMMC "rootfs" partition
#    (the image ships a small ext4; the stock image did the same via
#    /etc/init.d/rockchip.sh)
#  * generate unique SSH host keys (none are shipped in the image)
set -u

root_dev="$(findmnt -n -o SOURCE /)"
if [ ! -b "$root_dev" ]; then
    # The kernel reports /dev/root; use the last root= on the command line
    # (the vendor kernel appends root=/dev/mmcblk0p5).
    root_dev="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^root=//p' | tail -n 1)"
fi
case "$root_dev" in
    LABEL=*|UUID=*|PARTUUID=*) root_dev="$(blkid -o device -t "$root_dev" | head -n 1)" ;;
esac
if [ -b "$root_dev" ]; then
    resize2fs "$root_dev" || echo "speederpad-firstboot: resize2fs $root_dev failed" >&2
else
    echo "speederpad-firstboot: cannot determine root device; not resizing" >&2
fi

ssh-keygen -A

mkdir -p /var/lib/speederpad
touch /var/lib/speederpad/firstboot-done
